{% extends 'base.html.twig' %}

{% block title %}{{ 'menu.procedures'|trans }} - {{ parent() }}{% endblock %}

{% block content %}
<div class="procedures-container">
    {# En-tête de la page #}
    <div class="page-header mb-4">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="page-title">
                    <i class="fas fa-project-diagram me-3"></i>
                    {{ 'menu.procedures'|trans }}
                </h1>
                <p class="page-subtitle text-muted">
                    {{ 'procedures.subtitle'|trans }}
                </p>
            </div>
            <div class="col-lg-6 text-lg-end">
                <div class="page-actions">
                    <a href="{{ path('admin_procedures_new') }}" class="btn btn-primary me-2">
                        <i class="fas fa-plus me-1"></i>{{ 'menu.new_procedure'|trans }}
                    </a>
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                            <i class="fas fa-download me-1"></i>{{ 'actions.export'|trans }}
                        </button>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="{{ path('admin_procedures_export', {'format': 'excel'}) }}">
                                <i class="fas fa-file-excel me-2"></i>{{ 'formats.excel'|trans }}
                            </a></li>
                            <li><a class="dropdown-item" href="{{ path('admin_procedures_export', {'format': 'csv'}) }}">
                                <i class="fas fa-file-csv me-2"></i>{{ 'formats.csv'|trans }}
                            </a></li>
                        </ul>
                    </div>
                    <a href="{{ path('admin_procedures_import') }}" class="btn btn-outline-primary ms-2">
                        <i class="fas fa-upload me-1"></i>{{ 'procedures.import'|trans }}
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# Statistiques rapides #}
    <div class="procedures-stats mb-4">
        <div class="row g-3">
            <div class="col-lg-3 col-md-6">
                <div class="stat-box card border-start border-primary border-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="stat-icon bg-primary text-white rounded me-3">
                                <i class="fas fa-project-diagram"></i>
                            </div>
                            <div>
                                <h4 class="mb-0">{{ statistics.total ?? 0 }}</h4>
                                <small class="text-muted">{{ 'procedures.total_procedures'|trans }}</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-box card border-start border-success border-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="stat-icon bg-success text-white rounded me-3">
                                <i class="fas fa-check-circle"></i>
                            </div>
                            <div>
                                <h4 class="mb-0">{{ statistics.active ?? 0 }}</h4>
                                <small class="text-muted">{{ 'procedures.active_procedures'|trans }}</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-box card border-start border-warning border-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="stat-icon bg-warning text-white rounded me-3">
                                <i class="fas fa-edit"></i>
                            </div>
                            <div>
                                <h4 class="mb-0">{{ statistics.draft ?? 0 }}</h4>
                                <small class="text-muted">{{ 'procedures.draft_procedures'|trans }}</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="stat-box card border-start border-info border-4">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="stat-icon bg-info text-white rounded me-3">
                                <i class="fas fa-clock"></i>
                            </div>
                            <div>
                                <h4 class="mb-0">{{ statistics.avg_completion_time ?? 0 }}</h4>
                                <small class="text-muted">{{ 'procedures.avg_completion_days'|trans }}</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Filtres de recherche #}
    <div class="procedures-filters mb-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-search me-2"></i>{{ 'filters.search_and_filter'|trans }}
                </h5>
            </div>
            <div class="card-body">
                <form method="GET" action="{{ path('admin_procedures_index') }}" id="filtersForm">
                    <div class="row g-3">
                        <div class="col-lg-3 col-md-6">
                            <label for="search" class="form-label">{{ 'filters.search'|trans }}</label>
                            <input type="text" class="form-control" id="search" name="search" 
                                   value="{{ current_filters.search }}" 
                                   placeholder="{{ 'procedures.search_placeholder'|trans }}">
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label for="category" class="form-label">{{ 'procedures.category'|trans }}</label>
                            <select class="form-select" id="category" name="category">
                                <option value="">{{ 'procedures.all_categories'|trans }}</option>
                                {% for category in categories %}
                                    <option value="{{ category.id }}" {{ current_filters.category == category.id ? 'selected' : '' }}>
                                        {{ category.name|trans }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label for="status" class="form-label">{{ 'filters.status'|trans }}</label>
                            <select class="form-select" id="status" name="status">
                                <option value="">{{ 'filters.all_statuses'|trans }}</option>
                                <option value="active" {{ current_filters.status == 'active' ? 'selected' : '' }}>{{ 'status.active'|trans }}</option>
                                <option value="draft" {{ current_filters.status == 'draft' ? 'selected' : '' }}>{{ 'status.draft'|trans }}</option>
                                <option value="archived" {{ current_filters.status == 'archived' ? 'selected' : '' }}>{{ 'status.archived'|trans }}</option>
                            </select>
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <label for="complexity" class="form-label">{{ 'procedures.complexity'|trans }}</label>
                            <select class="form-select" id="complexity" name="complexity">
                                <option value="">{{ 'procedures.all_complexities'|trans }}</option>
                                <option value="simple" {{ current_filters.complexity == 'simple' ? 'selected' : '' }}>{{ 'procedures.simple'|trans }}</option>
                                <option value="medium" {{ current_filters.complexity == 'medium' ? 'selected' : '' }}>{{ 'procedures.medium'|trans }}</option>
                                <option value="complex" {{ current_filters.complexity == 'complex' ? 'selected' : '' }}>{{ 'procedures.complex'|trans }}</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6 d-flex align-items-end">
                            <div class="w-100">
                                <button type="submit" class="btn btn-primary me-2">
                                    <i class="fas fa-search me-1"></i>{{ 'actions.search'|trans }}
                                </button>
                                <a href="{{ path('admin_procedures_index') }}" class="btn btn-outline-secondary">
                                    <i class="fas fa-times me-1"></i>{{ 'actions.clear'|trans }}
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {# Liste des procédures #}
    <div class="procedures-list">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h5 class="card-title mb-0">
                            {{ 'procedures.list_title'|trans }} 
                            <span class="badge bg-secondary">{{ pagination.total_items }}</span>
                        </h5>
                    </div>
                    <div class="col-auto">
                        <div class="row g-2">
                            <div class="col-auto">
                                <select class="form-select form-select-sm" id="itemsPerPage" onchange="changeItemsPerPage(this.value)">
                                    <option value="10" {{ app.request.get('limit') == '10' ? 'selected' : '' }}>10</option>
                                    <option value="20" {{ app.request.get('limit') == '20' ? 'selected' : '' }}>20</option>
                                    <option value="50" {{ app.request.get('limit') == '50' ? 'selected' : '' }}>50</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                {% if procedures.items|length > 0 %}
                    <div class="procedures-grid">
                        {% for procedure in procedures.items %}
                            <div class="procedure-card">
                                <div class="card h-100">
                                    <div class="card-header d-flex justify-content-between align-items-start">
                                        <div class="procedure-info flex-grow-1">
                                            <h6 class="procedure-name mb-1">
                                                <a href="{{ path('admin_procedures_show', {'id': procedure.id}) }}" class="text-decoration-none">
                                                    {{ procedure.name }}
                                                </a>
                                            </h6>
                                            <small class="text-muted">{{ procedure.category|trans }}</small>
                                        </div>
                                        <div class="procedure-status">
                                            <span class="badge bg-{{ procedure.status == 'active' ? 'success' : (procedure.status == 'draft' ? 'warning' : 'secondary') }}">
                                                {{ procedure.status|trans }}
                                            </span>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <p class="procedure-description text-muted small">
                                            {{ procedure.description|slice(0, 120) }}{% if procedure.description|length > 120 %}...{% endif %}
                                        </p>
                                        <div class="procedure-metrics">
                                            <div class="row text-center">
                                                <div class="col-4">
                                                    <div class="metric-value">{{ procedure.estimated_duration }}</div>
                                                    <div class="metric-label">{{ 'procedures.duration'|trans }}</div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="metric-value">{{ procedure.success_rate }}%</div>
                                                    <div class="metric-label">{{ 'procedures.success_rate'|trans }}</div>
                                                </div>
                                                <div class="col-4">
                                                    <div class="metric-value complexity-{{ procedure.complexity }}">
                                                        {{ procedure.complexity|trans }}
                                                    </div>
                                                    <div class="metric-label">{{ 'procedures.complexity'|trans }}</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card-footer bg-transparent">
                                        <div class="row align-items-center">
                                            <div class="col">
                                                <small class="text-muted">
                                                    {{ 'procedures.updated'|trans }} {{ procedure.updated_at|date('d/m/Y') }}
                                                </small>
                                            </div>
                                            <div class="col-auto">
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a href="{{ path('admin_procedures_show', {'id': procedure.id}) }}" 
                                                       class="btn btn-outline-primary" title="{{ 'actions.view'|trans }}">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a href="{{ path('admin_procedures_edit', {'id': procedure.id}) }}" 
                                                       class="btn btn-outline-secondary" title="{{ 'actions.edit'|trans }}">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-outline-success" 
                                                            onclick="toggleProcedureStatus({{ procedure.id }})" 
                                                            title="{{ 'procedures.toggle_status'|trans }}">
                                                        <i class="fas fa-{{ procedure.status == 'active' ? 'pause' : 'play' }}"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-info dropdown-toggle" 
                                                            data-bs-toggle="dropdown" title="{{ 'actions.more'|trans }}">
                                                        <i class="fas fa-ellipsis-v"></i>
                                                    </button>
                                                    <ul class="dropdown-menu">
                                                        <li><a class="dropdown-item" href="#" onclick="duplicateProcedure({{ procedure.id }})">
                                                            <i class="fas fa-copy me-2"></i>{{ 'procedures.duplicate'|trans }}
                                                        </a></li>
                                                        <li><a class="dropdown-item" href="#" onclick="exportProcedure({{ procedure.id }})">
                                                            <i class="fas fa-download me-2"></i>{{ 'actions.export'|trans }}
                                                        </a></li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li><a class="dropdown-item text-danger" href="#" 
                                                               data-confirm="{{ 'procedures.confirm_delete'|trans }}">
                                                            <i class="fas fa-trash me-2"></i>{{ 'actions.delete'|trans }}
                                                        </a></li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="empty-state text-center py-5">
                        <i class="fas fa-project-diagram fa-3x text-muted mb-3"></i>
                        <h4>{{ 'procedures.no_procedures'|trans }}</h4>
                        <p class="text-muted">{{ 'procedures.no_procedures_message'|trans }}</p>
                        <a href="{{ path('admin_procedures_new') }}" class="btn btn-primary">
                            <i class="fas fa-plus me-1"></i>{{ 'procedures.create_first_procedure'|trans }}
                        </a>
                    </div>
                {% endif %}
            </div>
            
            {# Pagination #}
            {% if procedures.items|length > 0 %}
                <div class="card-footer">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <div class="pagination-info">
                                {{ 'pagination.showing'|trans({
                                    '%start%': ((pagination.current_page - 1) * 20) + 1,
                                    '%end%': ((pagination.current_page - 1) * 20) + procedures.items|length,
                                    '%total%': pagination.total_items
                                }) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            {% if pagination.total_pages > 1 %}
                                <nav aria-label="Pagination">
                                    <ul class="pagination pagination-sm justify-content-end mb-0">
                                        {% if pagination.current_page > 1 %}
                                            <li class="page-item">
                                                <a class="page-link" href="{{ path('admin_procedures_index', app.request.query.all|merge({'page': pagination.current_page - 1})) }}">
                                                    <i class="fas fa-chevron-left"></i>
                                                </a>
                                            </li>
                                        {% endif %}
                                        
                                        {% for page in range(max(1, pagination.current_page - 2), min(pagination.total_pages, pagination.current_page + 2)) %}
                                            <li class="page-item {{ page == pagination.current_page ? 'active' : '' }}">
                                                <a class="page-link" href="{{ path('admin_procedures_index', app.request.query.all|merge({'page': page})) }}">
                                                    {{ page }}
                                                </a>
                                            </li>
                                        {% endfor %}
                                        
                                        {% if pagination.current_page < pagination.total_pages %}
                                            <li class="page-item">
                                                <a class="page-link" href="{{ path('admin_procedures_index', app.request.query.all|merge({'page': pagination.current_page + 1})) }}">
                                                    <i class="fas fa-chevron-right"></i>
                                                </a>
                                            </li>
                                        {% endif %}
                                    </ul>
                                </nav>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    {# Raccourcis d'actions rapides #}
    <div class="procedures-shortcuts mt-4">
        <div class="row g-3">
            <div class="col-lg-3 col-md-6">
                <div class="shortcut-card card h-100">
                    <div class="card-body text-center">
                        <div class="shortcut-icon mb-3">
                            <i class="fas fa-sitemap fa-2x text-primary"></i>
                        </div>
                        <h6>{{ 'procedures.workflows'|trans }}</h6>
                        <p class="text-muted small">{{ 'procedures.manage_workflows'|trans }}</p>
                        <a href="{{ path('admin_procedures_workflows') }}" class="btn btn-outline-primary btn-sm">
                            {{ 'procedures.manage'|trans }}
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="shortcut-card card h-100">
                    <div class="card-body text-center">
                        <div class="shortcut-icon mb-3">
                            <i class="fas fa-chart-line fa-2x text-success"></i>
                        </div>
                        <h6>{{ 'procedures.analytics'|trans }}</h6>
                        <p class="text-muted small">{{ 'procedures.performance_analytics'|trans }}</p>
                        <a href="{{ path('admin_procedures_analytics') }}" class="btn btn-outline-success btn-sm">
                            {{ 'procedures.view_analytics'|trans }}
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="shortcut-card card h-100">
                    <div class="card-body text-center">
                        <div class="shortcut-icon mb-3">
                            <i class="fas fa-file-import fa-2x text-info"></i>
                        </div>
                        <h6>{{ 'procedures.templates'|trans }}</h6>
                        <p class="text-muted small">{{ 'procedures.procedure_templates'|trans }}</p>
                        <a href="#" class="btn btn-outline-info btn-sm">
                            {{ 'procedures.browse_templates'|trans }}
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="shortcut-card card h-100">
                    <div class="card-body text-center">
                        <div class="shortcut-icon mb-3">
                            <i class="fas fa-tools fa-2x text-warning"></i>
                        </div>
                        <h6>{{ 'procedures.optimization'|trans }}</h6>
                        <p class="text-muted small">{{ 'procedures.optimize_procedures'|trans }}</p>
                        <a href="#" class="btn btn-outline-warning btn-sm">
                            {{ 'procedures.run_optimization'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
<style>
.procedures-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 1.5rem;
    padding: 1.5rem;
}

.procedure-card .card {
    transition: all 0.3s ease;
    border: 1px solid #dee2e6;
}

.procedure-card .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 20px rgba(0,0,0,0.15);
    border-color: var(--primary-color);
}

.procedure-name a {
    color: var(--dark-color);
    font-weight: 600;
}

.procedure-name a:hover {
    color: var(--primary-color);
}

.procedure-description {
    line-height: 1.4;
    margin-bottom: 1rem;
}

.procedure-metrics {
    background-color: #f8f9fa;
    border-radius: 0.5rem;
    padding: 1rem;
    margin-bottom: 1rem;
}

.metric-value {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--primary-color);
}

.metric-label {
    font-size: 0.75rem;
    color: #6c757d;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.complexity-simple {
    color: #28a745;
}

.complexity-medium {
    color: #ffc107;
}

.complexity-complex {
    color: #dc3545;
}

.shortcut-card {
    transition: all 0.3s ease;
}

.shortcut-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.shortcut-icon {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    background-color: rgba(var(--primary-rgb), 0.1);
}

.stat-box {
    border: none;
    box-shadow: var(--box-shadow);
    transition: var(--transition);
}

.stat-box:hover {
    transform: translateY(-3px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
}

@media (max-width: 767.98px) {
    .procedures-grid {
        grid-template-columns: 1fr;
        padding: 1rem;
        gap: 1rem;
    }
    
    .procedure-metrics .row {
        text-align: center !important;
    }
    
    .shortcut-card {
        margin-bottom: 1rem;
    }
}
</style>
{% endblock %}

{% block javascripts %}
<script>
function toggleProcedureStatus(procedureId) {
    if (confirm('{{ 'procedures.confirm_toggle_status'|trans }}')) {
        fetch(`{{ path('admin_procedures_toggle_status', {'id': '__ID__'})|replace({'__ID__': ''}) }}${procedureId}`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Content-Type': 'application/json'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showNotification(data.message, 'success');
                setTimeout(() => window.location.reload(), 1000);
            } else {
                showNotification(data.message, 'error');
            }
        })
        .catch(error => {
            showNotification('{{ 'error.network'|trans }}', 'error');
            console.error('Error:', error);
        });
    }
}

function duplicateProcedure(procedureId) {
    if (confirm('{{ 'procedures.confirm_duplicate'|trans }}')) {
        fetch(`{{ path('admin_procedures_duplicate', {'id': '__ID__'})|replace({'__ID__': ''}) }}${procedureId}`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                showNotification(data.message, 'success');
                setTimeout(() => {
                    window.location.href = `{{ path('admin_procedures_edit', {'id': '__ID__'})|replace({'__ID__': ''}) }}${data.new_id}`;
                }, 1000);
            } else {
                showNotification(data.message, 'error');
            }
        })
        .catch(error => {
            showNotification('{{ 'error.network'|trans }}', 'error');
            console.error('Error:', error);
        });
    }
}

function exportProcedure(procedureId) {
    window.open(`{{ path('admin_procedures_export', {'format': 'pdf'})|replace({'format': 'pdf'}) }}pdf?procedure_id=${procedureId}`, '_blank');
}

function showNotification(message, type) {
    if (typeof adminCore !== 'undefined') {
        adminCore.showNotification(message, type);
    } else {
        alert(message);
    }
}
</script>
{% endblock %}